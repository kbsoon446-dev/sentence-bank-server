      "videoId": "Nj7KRXwTj6c",
      "start": 117,
      "end": 122,
      "text": "In fact, I'm going to go as low as P5 here.",
      "note": "",
      "createdAt": "2026-02-19T09:28:34.054Z",
      "updatedAt": "2026-02-19T09:33:45.935Z",
