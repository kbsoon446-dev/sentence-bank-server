      "lastGrade": "hard"
    },
    {
      "id": "688eb23cc86fdfcbc9b664b437",
      "videoId": "Nj7KRXwTj6c",
      "start": 1217,
      "end": 1222,
      "text": "I got to stop going for that waypoint if I'm not planning a leveling setup here.",
      "note": "",
      "createdAt": "2026-02-19T09:26:55.633Z",
      "updatedAt": "2026-02-19T09:31:49.154Z",
      "level": 0,
