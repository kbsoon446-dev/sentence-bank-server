      "lastGrade": "hard"
    },
    {
      "id": "51fd119c99812717af3632ee08",
      "videoId": "Nj7KRXwTj6c",
      "start": 2195,
      "end": 2200,
      "text": "No, it doesn't use weapon damage at all. It's just a flat value.",
      "note": "",
      "createdAt": "2026-02-19T09:26:35.135Z",
      "updatedAt": "2026-02-19T09:30:23.353Z",
