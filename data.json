    },
    {
      "id": "724209418c5948edf397bfdab34",
      "videoId": "Nj7KRXwTj6c",
      "start": 2354,
      "end": 2360,
      "text": "And also there's some items that can't",
      "note": "",
      "createdAt": "2026-02-19T09:26:22.401Z",
      "updatedAt": "2026-02-19T09:29:38.361Z",
      "level": 1,
