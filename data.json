    {
      "id": "27f2708aa35b3fb0c9e5d2668",
      "videoId": "Z7UBB41rF_o",
      "start": 410,
      "end": 420,
      "text": "well, she probably wasn't familiar with the process, having spent most of her life sitting for oil paintings",
      "note": "",
