      "videoId": "Z7UBB41rF_o",
      "start": 452,
      "end": 457,
      "text": "else you're supposed to be doing right now? Well, unless it's got something to",
      "note": "",
      "createdAt": "2026-02-20T04:59:33.276Z",
      "updatedAt": "2026-02-20T05:05:23.261Z",
      "level": 0,
      "dueAt": "2026-02-20T05:15:23.261Z",
      "reviewCount": 1,
