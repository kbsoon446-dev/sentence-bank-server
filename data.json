    },
    {
      "id": "629c6b15f612e88764403b848df",
      "videoId": "AN0QJ4m48Fw",
      "start": 175,
      "end": 180,
      "text": "Please tell me you're going to appeal to my humanity.",
      "note": "",
      "createdAt": "2026-02-19T04:02:22.832Z",
      "updatedAt": "2026-02-20T05:02:21.620Z",
