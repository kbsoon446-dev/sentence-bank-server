    },
    {
      "id": "c6f9ed9db9d0f92f9ae45ee4fe8",
      "videoId": "1e5GQGznvO4",
      "start": 70,
      "end": 78,
      "text": "at least that's what I heard. You know, I was there more as a friend and an observer than anything.",
      "note": "",
      "createdAt": "2026-02-19T08:42:54.899Z",
      "updatedAt": "2026-02-19T08:50:24.599Z",
