      "lastGrade": "good"
    },
    {
      "id": "cea5e1d2b4bacd56645ff359f78",
      "videoId": "Nj7KRXwTj6c",
      "start": 6,
      "end": 13,
      "text": "Been a while since we've seen a stamina potion. Yeah, not the most common early",
      "note": "",
      "createdAt": "2026-02-19T09:28:56.910Z",
      "updatedAt": "2026-02-19T09:34:08.903Z",
