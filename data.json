    },
    {
      "id": "b98478ad6bcffdb279141a2be5",
      "videoId": "Z7UBB41rF_o",
      "start": 545,
      "end": 549,
      "text": "Hi. I need those earrings you borrowed.",
      "note": "",
      "createdAt": "2026-02-20T04:58:15.251Z",
      "updatedAt": "2026-02-20T05:03:32.554Z",
