      "videoId": "Nj7KRXwTj6c",
      "start": 1087,
      "end": 1093,
      "text": "Except for the part where there's like video footage and evidence when I submit",
      "note": "",
      "createdAt": "2026-02-19T09:27:32.774Z",
      "updatedAt": "2026-02-20T00:37:16.876Z",
      "level": 0,
      "dueAt": "2026-02-21T00:37:16.876Z",
