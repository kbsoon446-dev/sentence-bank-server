      "videoId": "Nj7KRXwTj6c",
      "start": 849,
      "end": 852,
      "text": "What could possibly go wrong?",
      "note": "",
      "createdAt": "2026-02-19T09:27:58.312Z",
      "updatedAt": "2026-02-19T09:32:59.239Z",
      "level": 0,
