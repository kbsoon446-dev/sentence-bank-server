      "videoId": "Nj7KRXwTj6c",
      "start": 680,
      "end": 687,
      "text": "Yeah, cuz putting points into this itself doesn't actually increase its damage.",
      "note": "",
      "createdAt": "2026-02-19T09:28:17.726Z",
      "updatedAt": "2026-02-19T09:33:16.852Z",
