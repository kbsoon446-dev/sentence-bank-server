    },
    {
      "id": "4b4463be9aab9c4a02c9ea2348",
      "videoId": "Z7UBB41rF_o",
      "start": 462,
      "end": 469,
      "text": "Look, you have to help me out here. I thought we had a deal. I thought by the time I got You know what that is?",
      "note": "",
      "createdAt": "2026-02-20T04:59:09.479Z",
      "updatedAt": "2026-02-20T05:04:50.012Z",
