    },
    {
      "id": "a871229b12f6d49df6ccd943398",
      "videoId": "AN0QJ4m48Fw",
      "start": 71,
      "end": 79,
      "text": "I thought the beast had wandered off. >> Yeah, you're missing the point. There's no throne. There is no version of this",
      "note": "",
      "createdAt": "2026-02-19T04:02:50.524Z",
      "updatedAt": "2026-02-20T05:02:49.145Z",
      "level": 2,
