    },
    {
      "id": "105d36f3a7cf3f83a209fa9652",
      "videoId": "AN0QJ4m48Fw",
      "start": 204,
      "end": 206,
      "text": "You should have left your armor on for",
      "note": "",
      "createdAt": "2026-02-19T04:01:43.833Z",
      "updatedAt": "2026-02-19T09:22:36.923Z",
