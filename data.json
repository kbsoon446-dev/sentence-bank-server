      "videoId": "Z7UBB41rF_o",
      "start": 481,
      "end": 487,
      "text": "You know, you called me that before. So, I I took the liberty of fashioning a",
      "note": "",
      "createdAt": "2026-02-20T04:59:59.509Z",
      "updatedAt": "2026-02-20T05:05:57.839Z",
